# surová a velká data (stahovaná / regenerovatelná) — do repa nepatří
# Poznámka: data/* místo data/ – aby šlo odignorovat data/video/map.txt
data/*
!data/video/
data/video/*
!data/video/map.txt
# malé vstupy buildů — verzované (vendor JS, geokódování z admin_mapa.py,
# agregáty FIN/ČSÚ); bez nich neproběhne rebuild stránek v CI
!data/vendor/
!data/skolstvi/
data/skolstvi/*
!data/skolstvi/strelice_demografie.csv
!data/*.json
!data/*.csv
# výsledky voleb v obci (volby.cz) — vstup build_volby.py
!data/volby/
# shrnutí zasedání (psaná jazykovým modelem, nelze regenerovat skriptem)
!data/shrnuti/
zapisy_RO/
zastupitelstvo_ZO/
txt/
txt_zo/
_work/

