# Stará doména jakzijistrelice.cz (i www.) → nová adresa portálu, se zachováním cesty.
# mod_alias, ne mod_rewrite — interní přepisy na Wedosu dřív vracely 500.
# Wedos posílá alias interně do /domains/<doména>/ — tuhle předponu je nutné z cesty odříznout.
RedirectMatch 301 ^(?:/domains/[^/]+)?/(.*)$ https://strelice.jaksemame.cz/$1
